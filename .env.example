GOOGLE_SHEETS_API_KEY="your-google-sheets-api-key"
GOOGLE_SHEETS_ID="your-spreadsheet-id"
WP_GRAPHQL_ENDPOINT="https://ftbromania.ro/incubator/graphql"
REVALIDATE_TOKEN="your-revalidate-secret"

# Turso (libSQL) content database.
# Local dev: leave as "file:local.db" (created by `deno task db:migrate`).
# Production: libsql://<db-name>-<org>.turso.io + TURSO_AUTH_TOKEN from Turso dashboard.
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# WordPress (media uploads + admin auth via Application Passwords).
# WP_URL must NOT end with a slash. Create the app password in
# WP admin → Users → Profile → Application Passwords.
WP_URL="https://ftbromania.ro/incubator"
WP_USER="your-wp-username"
WP_APP_PASSWORD="your-wp-application-password"

# Set to "1" only for the colleague-facing demo deploy — adds noindex
# (robots meta + X-Robots-Tag header) so the demo is not search-indexed.
# Leave "0"/unset for production.
PUBLIC_DEMO="0"
