GOOGLE_SHEETS_API_KEY="your-google-sheets-api-key"
GOOGLE_SHEETS_ID="your-spreadsheet-id"
WP_GRAPHQL_ENDPOINT="https://ftbromania.ro/incubator/graphql"
REVALIDATE_TOKEN="your-revalidate-secret"

# Set to "1" only for the colleague-facing demo deploy — adds noindex
# (robots meta + X-Robots-Tag header) so the demo is not search-indexed.
# Leave "0"/unset for production.
PUBLIC_DEMO="0"
