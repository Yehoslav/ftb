{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode/big-pickle",
	"small_model": "opencode/big-pickle",
	"default_agent": "build",
	"instructions": ["AGENTS.md"],
	"agent": {
		"ui": {
			"description": "Svelte 5 UI development with Tailwind CSS v4, WCAG accessibility, responsive design",
			"mode": "primary",
			"model": "opencode/big-pickle",
			"color": "#2F378D",
			"permission": {
				"edit": "allow"
			}
		},
		"design": {
			"description": "Designer agent for Valeria: Svelte 5 UI layout/styles with WCAG, collaborating via vb/ feature branches, PRs into design/valeria, never touching master",
			"mode": "primary",
			"model": "opencode/big-pickle",
			"color": "#F39222",
			"permission": {
				"edit": "allow",
				"bash": "allow"
			}
		},
		"plan": {
			"model": "opencode/big-pickle"
		},
		"build": {
			"model": "opencode/big-pickle"
		},
		"explore": {
			"model": "opencode/big-pickle"
		}
	},
	"compaction": {
		"auto": true,
		"tail_turns": 5
	}
}
